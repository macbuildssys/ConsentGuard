<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:paddingBottom="12dp"
        android:text="Apps ConsentGuard leaves alone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E3EEE3"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="#1B1B1B"
        android:text="@string/protected_notice" />

    <Button
        android:id="@+id/showProtectedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="See protected apps on this phone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingTop="24dp"
        android:paddingBottom="4dp"
        android:text="Skip another app" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:paddingBottom="8dp"
        android:text="Type the app name as it shows on your home screen, then tap Add. ConsentGuard does nothing in apps on this list." />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <AutoCompleteTextView
            android:id="@+id/appNameInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="text|textNoSuggestions"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:completionThreshold="1"
            android:hint="App name"
            android:textSize="16sp" />

        <Button
            android:id="@+id/addAppButton"
            android:minWidth="104dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/skippedAppsList"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="24dp"
        android:textSize="12sp"
        android:textColor="#757575"
        android:text="@string/copyright_notice" />

</LinearLayout>

</ScrollView>
